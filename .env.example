# =========================================================
# PORTFOLIO CMS - ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in the values
# =========================================================

# --- SUPABASE CONFIG ---
# Get these from Project Settings > API
VITE_SUPABASE_URL=your_project_url_here
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here
# Service role key is used in server-side functions (DO NOT expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- CLOUDINARY CONFIG ---
# Required for Media Library (Upload/Transformation)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_API_KEY=your_api_key
VITE_CLOUDINARY_API_SECRET=your_api_secret

# --- EMAIL SERVICE (RESEND) ---
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=no-reply@yourdomain.com
TO_EMAIL=your_personal_email@example.com
RESEND_FROM_NAME="Your Portfolio Name"

# --- SITE CONFIG ---
VITE_API_URL=http://localhost:8080
VITE_SITE_URL=http://localhost:8080
VITE_ADMIN_EMAIL=your_email@example.com
